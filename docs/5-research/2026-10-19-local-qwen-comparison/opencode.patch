+func TestAKindTheEngineDoesNotRunStopsTheRunWithBadManifest(t *testing.T) {
+	r := start(t, "key-points", "", "  - { id: a, kind: exec, run: [echo, ok], repo: repos/app }\n", "steps: {}\n")
+	// ParseGraph enforces the kind's enum, so the bad kind is put into the parsed graph: a manifest
+	// the engine is given names a kind it does not run (backlog B-071).
+	r.Setup.Graph.Nodes[0].Kind = "frobnicate"
+	out, err := Advance(context.Background(), r)
+	if err != nil || out.Status != run.StatusFailed {
+		t.Fatalf("Advance() = %+v, %v; want the run stopped failed", out, err)
+	}
+	if !strings.Contains(out.Err.Error(), "bad_manifest") {
+		t.Errorf("Advance() = %+v; the failure must name bad_manifest", out)
+	}
+	text := ledgerText(t, r)
+	if !strings.Contains(text, `"event":"run_failed"`) || !strings.Contains(text, "bad_manifest") {
+		t.Errorf("the ledger:\n%s", text)
+	}
+}
