+
+func TestAnUnknownNodeKindIsABadManifest(t *testing.T) {
+	r := start(t, "key-points", "", "  - { id: a, kind: exec, run: [echo, hi], repo: repos/app }\n", "steps: {}\n")
+	// ParseGraph refuses the kinds its schema doesn't know; the case this covers is a graph whose
+	// schema is newer than the engine's (backlog B-071), so the node is put in after the run started.
+	r.Setup.Graph.Nodes = append([]schema.Node{{ID: "odd", Kind: "quincunx", Repo: "repos/app"}}, r.Setup.Graph.Nodes...)
+	out, err := Advance(context.Background(), r)
+	if err != nil || out.Status != run.StatusFailed || !strings.Contains(out.Err.Error(), "bad_manifest") {
+		t.Fatalf("Advance() = %+v, %v; want failed with bad_manifest", out, err)
+	}
+}
