{
  "$comment": "Ouroboric design tokens. Source of truth: README.md in this folder.",
  "dark": { "bg": "#0B0D12", "surface": "#14171F", "border": "#2A303C", "text": "#EDEFF3", "muted": "#9AA3B2", "accent": "#FF4F00", "accent-text": "#FF4F00", "on-accent": "#0B0D12", "ok": "#3FB950", "warn": "#D29922", "crit": "#F85149" },
  "light": { "bg": "#FFFFFF", "surface": "#F4F5F7", "border": "#D8DCE3", "text": "#0B0D12", "muted": "#4F5868", "accent": "#FF4F00", "accent-text": "#B83A00", "on-accent": "#0B0D12", "ok": "#1A7F37", "warn": "#9A6700", "crit": "#CF222E" },
  "type": {
    "fonts": {
      "wordmark": { "family": "Cinzel", "fallback": "Georgia, serif", "weights": [800] },
      "display": { "family": "Fjalla One", "fallback": "'Arial Narrow', sans-serif", "weights": [400] },
      "initial": { "family": "Cinzel", "fallback": "Georgia, serif", "weights": [800] },
      "heading": { "family": "Literata", "fallback": "Georgia, serif", "weights": [700, 600] },
      "body": { "family": "Literata", "fallback": "Georgia, serif", "weights": [400, 700], "italic": [400, 700] },
      "ui": { "family": "Inter", "fallback": "system-ui, sans-serif", "weights": [400, 600] },
      "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace", "weights": [400, 600] },
      "ornament": { "family": "Noto Sans Runic", "fallback": "sans-serif", "weights": [400] }
    },
    "scale": {
      "display-xl": { "size": "3.5rem", "leading": 1.05, "role": "display" },
      "display": { "size": "2.5rem", "leading": 1.1, "role": "display" },
      "h2": { "size": "1.75rem", "leading": 1.2, "role": "heading", "weight": 700 },
      "h3": { "size": "1.375rem", "leading": 1.25, "role": "heading", "weight": 700 },
      "h4": { "size": "1.125rem", "leading": 1.3, "role": "heading", "weight": 600 },
      "body": { "size": "1.0625rem", "leading": 1.6, "role": "body", "weight": 400 },
      "ui": { "size": "0.875rem", "leading": 1.45, "role": "ui" },
      "caption": { "size": "0.75rem", "leading": 1.4, "role": "ui", "weight": 400 },
      "mono": { "size": "0.875em", "leading": 1.5, "role": "mono", "weight": 400 }
    },
    "licence": "OFL-1.1"
  }
}
