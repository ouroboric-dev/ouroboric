grid-rows: 2
vertical-gap: 40
ouroboric: "Ouroboric: the company (the Ouroboros is its symbol)" {
  grid-columns: 2
  journal: "Journal and content" {
    sagas: "Sagas\nthe journal"
    bragi: "Bragi\nposts from the sagas" {style.stroke-dash: 4}
    sagas -> bragi: "feeds"
  }
  yggdrasil: "Yggdrasil: agentic factory" {
    grid-columns: 2
    core: "Core (v0)" {
      odin: "Odin\norchestrator"
      jorm: "Jormungandr\nloop"
      gleipnir: "Gleipnir\nharness"
      havamal: "Havamal\nskill library"
      gungnir: "Gungnir\ncontract"
      odin -> jorm
      odin -> gleipnir
      gleipnir -> havamal: "loads"
    }
    realms: "Realms (recipes for Odin)" {
      grid-columns: 3
      midgard: "Midgard\nweb frontends"
      helheim: "Helheim\nbackend"
      asgard: "Asgard\nkickstart, Ginnungagap graph" {style.stroke-dash: 4}
      jotunheim: "Jotunheim\ngames" {style.stroke-dash: 4}
      muspelheim: "Muspelheim\nmobile" {style.stroke-dash: 4}
      niflheim: "Niflheim\ninfrastructure" {
        style.stroke-dash: 4
        style.fill: ${surface}
        style.font-color: ${muted}
      }
      nidavellir: "Nidavellir\ndesktop and CLI" {
        style.stroke-dash: 4
        style.fill: ${surface}
        style.font-color: ${muted}
      }
      alfheim: "Alfheim\nart" {
        style.stroke-dash: 4
        style.fill: ${surface}
        style.font-color: ${muted}
      }
      vanaheim: "Vanaheim\nresearch" {
        style.stroke-dash: 4
        style.fill: ${surface}
        style.font-color: ${muted}
      }
    }
    later: "Later modules" {
      style.stroke-dash: 4
      grid-columns: 1
      ratatoskr: "Ratatoskr\nrouting" {style.stroke-dash: 4}
      norns: "Norns\nobservability" {style.stroke-dash: 4}
      mimir: "Mimir\nbenchmarks" {style.stroke-dash: 4}
    }
    optional: "Optional names" {
      style.stroke-dash: 1
      grid-columns: 1
      heimdall: "Heimdall\napproval points" {style.stroke-dash: 1}
      bifrost: "Bifrost\nintegrations" {style.stroke-dash: 1}
    }
  }
  future: "Future factories" {
    style.stroke-dash: 4
    style.fill: ${surface}
    style.font-color: ${muted}
    product: "product factory"
  }
}
notes: "" {
  style.stroke-width: 0
  style.fill: transparent
  grid-columns: 3
  legend: "Legend" {
    v0: "v0 (now)"
    later: "later" {style.stroke-dash: 4}
    optional: "optional name" {style.stroke-dash: 1}
    illustrative: "illustrative, not committed" {
      style.stroke-dash: 4
      style.fill: ${surface}
      style.font-color: ${muted}
    }
  }
  fenrir: "Fenrir\nthe models and agents,\nbound by Gleipnir"
  adversaries: "Adversaries" {
    style.stroke: ${accent}
    style.stroke-width: 2
    loki: "Loki\nprompt injection"
    nidhogg: "Nidhogg\nentropy, AI slop"
    ragnarok: "Ragnarok\nthe cascade"
  }
}
