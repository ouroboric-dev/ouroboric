vars: {
  d2-config: {
    theme-id: 1
  }
}
direction: down
operator: "Operator" {shape: person}
ouroboric: "Ouroboric: the company\ncharter, standards, journal, brand" {
  asgard: "Asgard: company factory" {
    readiness: "Readiness checklist\n(v0)"
    ginnungagap: "Ginnungagap\nkickstart graph (later)"
  }
  yggdrasil: "Yggdrasil: software factory" {
    odin: "Odin\norchestrator, ygg CLI"
    jorm: "Jormungandr\nbuild, check, fix loop"
    gleipnir: "Gleipnir\nharness: agents, sandbox"
    havamal: "Havamal\nskill library"
    realms: "Realms\nweb (v0), game (later)"
    gungnir: "Gungnir\ncontract for all modules" {style.stroke-dash: 4}
    later: "Later: Ratatoskr routing, Norns observability,\nMimir benchmarks, Bragi content" {style.stroke-dash: 4}
    realms -> odin: "recipes"
    odin -> jorm
    odin -> gleipnir
    gleipnir -> havamal: "loads skills"
  }
  asgard -> yggdrasil.odin: "runs on"
}
products: "Companies and products it makes\ne.g. photografy, client gallery"
operator -> ouroboric.asgard: "approves direction" {style.stroke: "#FF4F00"; style.stroke-width: 3}
ouroboric.asgard -> products: "kickstarts"
ouroboric.yggdrasil -> products: "builds and verifies"
products -> ouroboric: "lessons and benchmarks feed back" {style.stroke-dash: 4; style.stroke: "#FF4F00"}
