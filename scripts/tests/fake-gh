#!/usr/bin/env bash
# Fake gh for the script tests: "gh api" answers GETs from $FAKE_GH_DIR/GET/<path, / as _>.json
# (404 when the file is missing; see ERR below) and logs every other request as a JSON line in
# $FAKE_GH_DIR/log (with the -F/-f fields as "key=value" strings).
set -uo pipefail
[ "${1:-}" = api ] || { echo "fake gh: only 'gh api' is faked" >&2; exit 2; }
shift
method=GET path='' q='' input='' fields=''
while [ $# -gt 0 ]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    -q) q="$2"; shift 2 ;;
    --input) input="$2"; shift 2 ;;
    -F|-f) fields+="$2"$'\n'; shift 2 ;;
    --silent|--paginate) shift ;;
    *) path="$1"; shift ;;
  esac
done
if [ "$method" != GET ]; then
  body=''; [ "$input" = - ] && body="$(cat)"
  jq -cn --arg m "$method" --arg p "$path" --arg b "$body" --arg f "$fields" '{method:$m,path:$p,body:$b,fields:($f|split("\n")|map(select(.!="")))}' >> "$FAKE_GH_DIR/log"
  echo '{}'; exit 0
fi
f="$FAKE_GH_DIR/GET/${path//\//_}.json"
# A file at $FAKE_GH_DIR/ERR/<path, / as _> makes that GET fail with its contents, such as "HTTP 500".
e="$FAKE_GH_DIR/ERR/${path//\//_}"
[ -f "$e" ] && { echo "gh: $(cat "$e")" >&2; exit 1; }
[ -f "$f" ] || { echo '{"message":"Not Found"}'; echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
if [ -n "$q" ]; then jq -r "$q" "$f"; else cat "$f"; fi
